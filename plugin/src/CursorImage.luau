--!strict
--[[
	The pointer the input relay draws on screen, as raw pixels.

	Generated from assets/cursor.png -- regenerate with:
	    node scripts/cursor-data.mjs assets/cursor.png 48 <out>

	It ships as text because there is nowhere better to put it. A LocalScript
	cannot decode a PNG, and uploading the image as a Roblox asset would put a
	manual step between cloning this repo and having a working cursor. 48x48 RGBA
	is 9KB of pixels, which base64 makes 12KB of source -- cheap enough that the
	alternative is not worth its trouble.
]]

return {
	size = 48,
	-- Hotspot as a fraction of the image: the arrow's tip, near the top left.
	hotspotX = 0.08,
	hotspotY = 0.06,
	base64 = "",
}
