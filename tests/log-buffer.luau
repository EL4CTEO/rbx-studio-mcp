local buffer = ...
buffer.start()
listeners.message("studio print", Enum.MessageType.MessageOutput)
local studio, dropped, token, sequence = buffer.stream(nil)
assert(#studio == 1 and studio[1].message == "studio print" and studio[1].sequence == 1)
assert(dropped == 0 and sequence == 1)
local alice = { Name = "Alice" }
local bob = { Name = "Bob" }
buffer.startClient(alice)
buffer.startClient(bob)
buffer.pushClient(alice, { kind = "ready" })
assert(buffer.clientReady(alice) and not buffer.clientReady(bob))
buffer.pushClient(alice, { kind = "trace", message = "boom", stack = "line 1", source = "PlayerGui.Test" })
buffer.pushClient(alice, { level = "error", message = "boom", timestamp = 10 })
buffer.pushClient(bob, { level = "print", message = "bob" })
local a, _, aToken, aSequence = buffer.stream(alice)
local b, _, bToken = buffer.stream(bob)
assert(#a == 1 and a[1].stack == "line 1" and a[1].source == "PlayerGui.Test")
assert(#b == 1 and b[1].message == "bob")
assert(aToken ~= bToken and aToken ~= token and aSequence == 1)
buffer.pushClient(alice, { level = "evil", message = "ignored" })
assert(#(select(1, buffer.stream(alice))) == 1)
for index = 1, 2600 do buffer.pushClient(alice, { level = "print", message = tostring(index) }) end
local bounded, lost, _, latest = buffer.stream(alice)
assert(#bounded <= 2500 and lost > 0 and bounded[1].sequence > 1 and latest == 2601)
-- A respawn reinstalls the relay: same log, same cursor, waiting for ready again.
buffer.pushClient(alice, { kind = "ready" })
buffer.startClient(alice)
local kept, _, keptToken, keptSequence = buffer.stream(alice)
assert(#kept == #bounded and keptToken == aToken and keptSequence == 2601, "respawn keeps the log")
assert(not buffer.clientReady(alice), "and waits for the new relay")
buffer.stopClient(alice)
buffer.startClient(alice)
local _, _, freshToken, freshSequence = buffer.stream(alice)
assert(freshToken ~= aToken and freshSequence == 0)
print("log buffer: ok")
