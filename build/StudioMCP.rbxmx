<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <Item class="Script" referent="RBX0">
    <Properties>
      <string name="Name">StudioMCP</string>
      <ProtectedString name="Source"><![CDATA[--!strict
--[[
	Studio MCP -- plugin entry point.

	Owns the toolbar UI, the persistent Studio identity, and the command loop.
	Handlers do the actual work; this file only wires them to the transport.
]]

local HttpService = game:GetService("HttpService")

local Config = require(script.Config)
local Dispatch = require(script.Dispatch)
local Transport = require(script.Transport)
local Session = require(script.handlers.Session)

local SETTING_STUDIO_ID = "studioId"
local SETTING_PORT = "port"
local SETTING_AUTOCONNECT = "autoConnect"

--[[
	A stable id per Studio installation, so reconnects and restarts map back to
	the same session rather than piling up ghost entries in list_studios.
]]
local function studioId(): string
	local existing = plugin:GetSetting(SETTING_STUDIO_ID)
	if typeof(existing) == "string" and existing ~= "" then
		return existing
	end
	local generated = HttpService:GenerateGUID(false)
	plugin:SetSetting(SETTING_STUDIO_ID, generated)
	return generated
end

local storedPort = plugin:GetSetting(SETTING_PORT)
if typeof(storedPort) == "number" then
	Config.setPort(storedPort)
end

Session.register()

local toolbar = plugin:CreateToolbar("Studio MCP")
local button = toolbar:CreateButton(
	"Studio MCP",
	"Connect this place to the Studio MCP server",
	"rbxasset://textures/ui/common/robux.png"
)
button.ClickableWhenViewportHidden = true

local widget = plugin:CreateDockWidgetPluginGuiAsync(
	"StudioMCP_Status",
	DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, true, 320, 120, 260, 100)
)
widget.Title = "Studio MCP"

local background = Instance.new("Frame")
background.Size = UDim2.fromScale(1, 1)
background.BorderSizePixel = 0
background.Parent = widget

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 8)
padding.PaddingLeft = UDim.new(0, 10)
padding.PaddingRight = UDim.new(0, 10)
padding.Parent = background

local label = Instance.new("TextLabel")
label.Size = UDim2.fromScale(1, 1)
label.BackgroundTransparency = 1
label.TextWrapped = true
label.TextXAlignment = Enum.TextXAlignment.Left
label.TextYAlignment = Enum.TextYAlignment.Top
label.Font = Enum.Font.Code
label.TextSize = 13
label.Text = ""
label.Parent = background

-- Studio themes are user-switchable at runtime, so colours are read from the
-- theme on every render rather than baked in once.
local studioSettings = settings():GetService("Studio")

local currentStatus: Transport.Status = "disconnected"

--[[
	The widget is the only feedback channel a user has -- the plugin deliberately
	prints nothing to the output window, since that log is also what the agent
	reads through the `console` tool and plugin chatter would pollute it.
]]
local function render(detail: string?)
	local theme = (studioSettings :: any).Theme
	label.TextColor3 = theme:GetColor(Enum.StudioStyleGuideColor.MainText)
	background.BackgroundColor3 = theme:GetColor(Enum.StudioStyleGuideColor.MainBackground)

	local lines = {
		string.format("Status: %s", currentStatus),
		string.format("Port:   %d (%s)", Config.getPort(), Transport.getMode()),
	}
	if detail then
		table.insert(lines, "")
		table.insert(lines, detail)
	end
	label.Text = table.concat(lines, "\n")
	button:SetActive(currentStatus == "connected")
end

local function onStatus(status: Transport.Status, detail: string?)
	currentStatus = status
	render(detail)
end

--[[
	Runs each command on its own task. Handlers may yield -- `UpdateSourceAsync`
	and any `*Async` call does -- and serialising them would let one slow edit
	stall every other request on the stream.
]]
local function onCommand(id: string, op: string, params: { [string]: any }?)
	task.spawn(function()
		Transport.sendResult(Dispatch.invoke(id, op, params))
	end)
end

local function connect()
	Transport.start(studioId(), { onCommand = onCommand, onStatus = onStatus })
	plugin:SetSetting(SETTING_AUTOCONNECT, true)
end

local function disconnect()
	Transport.stop()
	plugin:SetSetting(SETTING_AUTOCONNECT, false)
	onStatus("disconnected", "Disconnected. Click the toolbar button to reconnect.")
end

button.Click:Connect(function()
	if Transport.isRunning() then
		disconnect()
	else
		widget.Enabled = true
		connect()
	end
end)

widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	if widget.Enabled then
		render()
	end
end)

plugin.Unloading:Connect(function()
	Transport.stop()
end)

render()

-- Reconnect automatically unless the user explicitly disconnected last session.
if plugin:GetSetting(SETTING_AUTOCONNECT) ~= false then
	connect()
end
]]></ProtectedString>
      <bool name="Disabled">false</bool>
      <token name="RunContext">0</token>
    </Properties>
    <Item class="ModuleScript" referent="RBX1">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source"><![CDATA[--!strict
--[[
	Connection settings for the Studio MCP plugin.

	The port must match the one the Node server was started with (`--port`, or
	the ROBLOX_STUDIO_MCP_PORT environment variable). It is stored as a plugin
	setting so a user running on a non-default port only has to set it once.
]]

local Config = {}

Config.PLUGIN_VERSION = "0.1.0"
Config.PROTOCOL_VERSION = 1
Config.DEFAULT_PORT = 44755

-- Header the bridge requires on every request. A web page cannot set it
-- cross-origin without a preflight the bridge never answers, which is what
-- keeps a malicious site from driving Studio through the loopback port.
Config.CLIENT_HEADER = "x-roblox-studio-mcp"

-- How long to wait before retrying after the stream drops. Studio closes SSE
-- connections at the 30 minute mark, so reconnects are routine, not exceptional.
Config.RECONNECT_DELAY = 1
Config.MAX_RECONNECT_DELAY = 30

local port: number? = nil

function Config.setPort(value: number)
	port = value
end

function Config.getPort(): number
	return port or Config.DEFAULT_PORT
end

function Config.baseUrl(): string
	return string.format("http://127.0.0.1:%d", Config.getPort())
end

function Config.headers(): { [string]: string }
	return {
		[Config.CLIENT_HEADER] = tostring(Config.PROTOCOL_VERSION),
		["Content-Type"] = "application/json",
	}
end

return Config
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">Dispatch</string>
        <ProtectedString name="Source"><![CDATA[--!strict
--[[
	Handler registry and the single error boundary around every command.

	Handlers raise failures with `Dispatch.fail(code, message, hint)`. The hint is
	forwarded verbatim to the agent, so it should say what to do next ("call find
	first to get a valid path"), not just what went wrong.
]]

local Dispatch = {}

export type Error = {
	code: string,
	message: string,
	hint: string?,
}

export type Handler = (params: { [string]: any }) -> any

local handlers: { [string]: Handler } = {}

function Dispatch.register(op: string, handler: Handler)
	handlers[op] = handler
end

--[[
	Registers every entry of `map` under the prefix, e.g. `registerAll("script",
	{ read = fn })` exposes "script.read".
]]
function Dispatch.registerAll(prefix: string, map: { [string]: Handler })
	for name, handler in map do
		handlers[prefix .. "." .. name] = handler
	end
end

--[[
	Raises a structured failure. Always call this rather than `error("...")` so
	the agent receives a code it can branch on and a hint it can act on.
]]
function Dispatch.fail(code: string, message: string, hint: string?): never
	error({ code = code, message = message, hint = hint }, 0)
end

export type Result = {
	id: string,
	ok: boolean,
	data: any?,
	error: Error?,
}

--[[
	Runs one command and returns the frame to POST back. Never throws: an
	unhandled error inside a handler becomes a HANDLER_ERROR result, because a
	crashed dispatch would leave the server's promise hanging until it times out.
]]
function Dispatch.invoke(id: string, op: string, params: { [string]: any }?): Result
	local handler = handlers[op]
	if not handler then
		return {
			id = id,
			ok = false,
			error = {
				code = "UNKNOWN_OP",
				message = string.format('This Studio plugin has no handler for "%s".', op),
				hint = "The plugin is older than the MCP server. Update the Studio MCP "
					.. "plugin to the version matching your server.",
			},
		}
	end

	local ok, result = pcall(handler, params or {})
	if ok then
		return { id = id, ok = true, data = result }
	end

	if typeof(result) == "table" and (result :: any).code then
		return { id = id, ok = false, error = result :: Error }
	end

	return {
		id = id,
		ok = false,
		error = {
			code = "HANDLER_ERROR",
			message = string.format('"%s" failed: %s', op, tostring(result)),
		},
	}
end

return Dispatch
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBX3">
      <Properties>
        <string name="Name">handlers</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX4">
        <Properties>
          <string name="Name">Session</string>
          <ProtectedString name="Source"><![CDATA[--!strict
--[[
	Session and connectivity handlers. `studio.status` is the cheapest call in the
	system and doubles as the liveness probe, so it must never touch anything
	expensive -- notably it counts descendants lazily and caps the selection.
]]

local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")

local Dispatch = require(script.Parent.Parent.Dispatch)
local Paths = require(script.Parent.Parent.Paths)

-- `version()` is marked deprecated but remains the only way to read the Studio
-- build, and the agent needs it to know which engine APIs actually exist in this
-- session. Bound indirectly so the deprecation lint stays enabled file-wide.
local studioVersion: () -> string = (version :: any)

-- Selection can be tens of thousands of instances after a rubber-band drag.
-- Anything past this is noise for an agent and would blow the response budget.
local MAX_SELECTION = 50

-- Counting descendants of a large place is O(n) over the whole DataModel, so it
-- is cached briefly; status is polled often enough for this to matter.
local COUNT_CACHE_SECONDS = 5

local cachedCounts: { descendants: number, scripts: number }? = nil
local cachedAt = 0

local function counts(): { descendants: number, scripts: number }
	local now = os.clock()
	local cache = cachedCounts
	if cache and now - cachedAt < COUNT_CACHE_SECONDS then
		return cache
	end

	local descendants = 0
	local scripts = 0
	for _, instance in game:GetDescendants() do
		descendants += 1
		if instance:IsA("LuaSourceContainer") then
			scripts += 1
		end
	end

	local fresh = { descendants = descendants, scripts = scripts }
	cachedCounts = fresh
	cachedAt = now
	return fresh
end

local Session = {}

function Session.status(): { [string]: any }
	local selected: { { path: string, className: string } } = {}
	for index, instance in Selection:Get() do
		if index > MAX_SELECTION then
			break
		end
		table.insert(selected, { path = Paths.of(instance), className = instance.ClassName })
	end

	local totals = counts()
	return {
		placeName = if game.Name ~= "" then game.Name else "Untitled place",
		placeId = game.PlaceId,
		-- RunService:IsRunning() is true for both Play and Run; IsEdit()
		-- distinguishes the authoring session from a live one.
		isRunning = RunService:IsRunning(),
		isEdit = RunService:IsEdit(),
		isRunMode = RunService:IsRunning() and not RunService:IsClient(),
		isServerView = RunService:IsServer(),
		selection = selected,
		selectionCount = #Selection:Get(),
		descendantCount = totals.descendants,
		scriptCount = totals.scripts,
		studioVersion = studioVersion(),
	}
end

--[[
	Round-trip probe used by the smoke test and by `studio_status` when the agent
	only needs to know the channel is alive.
]]
function Session.ping(params: { [string]: any }): { [string]: any }
	return { pong = true, echo = params.echo }
end

function Session.register()
	Dispatch.registerAll("studio", {
		status = function()
			return Session.status()
		end,
		ping = Session.ping,
	})
end

return Session
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="RBX5">
      <Properties>
        <string name="Name">Net</string>
        <ProtectedString name="Source"><![CDATA[--!strict
--[[
	Thin HttpService wrapper.

	Plugins reach 127.0.0.1 through a per-plugin permission grant rather than the
	experience-wide "Allow HTTP Requests" setting, so the first request after
	install pops a permission dialog. That failure mode is turned into a message
	the user can act on instead of a raw Luau error.
]]

local HttpService = game:GetService("HttpService")

local Config = require(script.Parent.Config)

local Net = {}

export type Response = {
	ok: boolean,
	statusCode: number,
	body: string,
	error: string?,
}

--[[
	Performs a request and never throws. Callers branch on `ok`; `error` carries
	a user-facing explanation when the request could not be made at all.
]]
function Net.request(method: string, path: string, body: string?): Response
	local ok, result = pcall(function()
		return HttpService:RequestAsync({
			Url = Config.baseUrl() .. path,
			Method = method,
			Headers = Config.headers(),
			Body = body,
		})
	end)

	if not ok then
		return {
			ok = false,
			statusCode = 0,
			body = "",
			error = Net.explain(tostring(result)),
		}
	end

	local response = result :: any
	return {
		ok = response.Success,
		statusCode = response.StatusCode,
		body = response.Body,
	}
end

function Net.postJson(path: string, value: any): Response
	return Net.request("POST", path, HttpService:JSONEncode(value))
end

--[[
	Turns HttpService's terse errors into something the user can act on. These
	strings surface in the plugin widget, so they are written for a person, not
	for the agent.
]]
function Net.explain(message: string): string
	local lowered = string.lower(message)

	if string.find(lowered, "not enabled") or string.find(lowered, "permission") then
		return "Studio blocked the request. Open Plugins -> Manage Plugins, find "
			.. "Studio MCP, and allow it to reach 127.0.0.1."
	end
	if
		string.find(lowered, "connectfail")
		or string.find(lowered, "curl")
		or string.find(lowered, "could not connect")
		or string.find(lowered, "connection refused")
	then
		return string.format(
			"Nothing is listening on port %d. Start the server with "
				.. "`npx -y roblox-studio-mcp` (or check --port if you changed it).",
			Config.getPort()
		)
	end
	if string.find(lowered, "timedout") or string.find(lowered, "timeout") then
		return "The server stopped responding. It may have been restarted; "
			.. "the plugin will keep retrying."
	end
	return message
end

--[[
	Decodes a JSON body, returning nil rather than throwing on malformed input.
	A truncated frame is a transport hiccup, not a reason to kill the plugin.
]]
function Net.decode(body: string): any?
	local ok, value = pcall(HttpService.JSONDecode, HttpService, body)
	if not ok then
		return nil
	end
	return value
end

return Net
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX6">
      <Properties>
        <string name="Name">Paths</string>
        <ProtectedString name="Source"><![CDATA[--!strict
--[[
	Dot-notation instance paths, e.g. "Workspace.Map.Spawn".

	Paths are the address format for every tool, so resolution failures are the
	most common error an agent will hit. Each failure says which segment broke
	and what does exist at that level, which is usually enough for the model to
	fix the path itself instead of falling back to a blind tree dump.
]]

local Dispatch = require(script.Parent.Dispatch)

local Paths = {}

--[[
	Splits a path into segments. A leading "game." is optional and stripped, so
	both "game.Workspace.Part" and "Workspace.Part" resolve identically.
]]
function Paths.split(path: string): { string }
	local segments: { string } = {}
	for segment in string.gmatch(path, "[^%.]+") do
		table.insert(segments, segment)
	end
	if segments[1] == "game" then
		table.remove(segments, 1)
	end
	return segments
end

local function childNames(parent: Instance, limit: number): string
	local names: { string } = {}
	for _, child in parent:GetChildren() do
		table.insert(names, child.Name)
		if #names >= limit then
			table.insert(names, "...")
			break
		end
	end
	if #names == 0 then
		return "(no children)"
	end
	return table.concat(names, ", ")
end

--[[
	Resolves a path to an Instance, or raises a NOT_FOUND with the failing
	segment and its siblings. `FindFirstChild` is used rather than indexing so a
	missing child never throws a bare Luau error.
]]
function Paths.resolve(path: string): Instance
	if typeof(path) ~= "string" or path == "" then
		Dispatch.fail(
			"BAD_PATH",
			"An instance path is required.",
			'Paths are dot-separated from the DataModel root, e.g. "Workspace.Map.Spawn". '
				.. "Use `find` or `tree` to discover valid paths."
		)
	end

	local segments = Paths.split(path)
	if #segments == 0 then
		return game
	end

	local current: Instance = game
	for index, segment in segments do
		local nextInstance: Instance? = nil

		if index == 1 then
			-- Services must be fetched by class name, and are not always
			-- present as children until first accessed.
			local ok, service = pcall(function()
				return game:GetService(segment :: any)
			end)
			nextInstance = if ok then service else current:FindFirstChild(segment)
		else
			nextInstance = current:FindFirstChild(segment)
		end

		if not nextInstance then
			local partial = table.concat(segments, ".", 1, index)
			-- `fail` never returns; returning its result keeps that visible to
			-- the type checker so `current` stays non-optional below.
			return Dispatch.fail(
				"NOT_FOUND",
				string.format('No instance at "%s".', partial),
				string.format(
					'"%s" has no child named "%s". It does have: %s',
					current:GetFullName(),
					segment,
					childNames(current, 25)
				)
			)
		end
		current = nextInstance
	end

	return current
end

--[[
	Resolves many paths at once, collecting failures instead of stopping at the
	first one. Batch tools report every bad path in a single response so the
	agent can fix them all in one retry rather than one call per mistake.
]]
function Paths.resolveMany(paths: { string }): ({ Instance }, { string })
	local resolved: { Instance } = {}
	local failures: { string } = {}
	for _, path in paths do
		local ok, result = pcall(Paths.resolve, path)
		if ok then
			table.insert(resolved, result :: Instance)
		else
			local err = result :: any
			table.insert(
				failures,
				string.format("%s: %s", path, if typeof(err) == "table" then err.message else tostring(err))
			)
		end
	end
	return resolved, failures
end

--[[
	Formats an instance back into a path the tools accept. `GetFullName` returns
	"Workspace.Map.Spawn" for descendants of services, which round-trips through
	`resolve` unchanged.
]]
function Paths.of(instance: Instance): string
	return instance:GetFullName()
end

return Paths
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX7">
      <Properties>
        <string name="Name">ScriptEdit</string>
        <ProtectedString name="Source"><![CDATA[--!strict
--[[
	Editor-safe script reading and writing.

	Every other Roblox Studio MCP server assigns `script.Source` directly. That is
	wrong in a specific, silent way: when the script is open in the Studio script
	editor, the editor holds its own buffer, and a direct Source write either gets
	overwritten by that buffer or discards the user's unsaved edits. Roblox added
	`ScriptEditorService:UpdateSourceAsync` precisely to close this gap -- it
	routes the change through the editor so the open document, its undo stack and
	the saved source all stay in agreement.

	The cost is that it yields, so every write here is async. That is the whole
	reason handlers are allowed to yield.
]]

local ScriptEditorService = game:GetService("ScriptEditorService")

local Dispatch = require(script.Parent.Dispatch)

local ScriptEdit = {}

export type SourceContainer = LuaSourceContainer & { Source: string }

--[[
	Reads current source. `GetEditorSource` is preferred over `.Source` because it
	returns the editor's live buffer, including edits the user has typed but not
	saved -- reading `.Source` there would hand the agent stale code and it would
	then "fix" changes the user just made.
]]
function ScriptEdit.read(target: LuaSourceContainer): string
	local ok, source = pcall(function()
		return ScriptEditorService:GetEditorSource(target)
	end)
	if ok and typeof(source) == "string" then
		return source
	end
	return (target :: SourceContainer).Source
end

--[[
	Replaces source through the editor. `transform` receives the current text and
	returns the replacement; returning the input unchanged is a no-op.

	Raises SCRIPT_LOCKED when the write is refused, which normally means the
	script is a package member or is owned by another Team Create session.
]]
function ScriptEdit.write(target: LuaSourceContainer, transform: (string) -> string)
	local ok, err = pcall(function()
		ScriptEditorService:UpdateSourceAsync(target, transform)
	end)
	if ok then
		return
	end

	local message = tostring(err)
	if string.find(string.lower(message), "lock") or string.find(string.lower(message), "permission") then
		Dispatch.fail(
			"SCRIPT_LOCKED",
			string.format("Studio refused to edit %s: %s", target:GetFullName(), message),
			"The script is usually locked because it belongs to a package or is "
				.. "checked out by another Team Create user. Ask the user to unlock it, "
				.. "or edit a different script."
		)
	end
	Dispatch.fail(
		"EDIT_FAILED",
		string.format("Could not edit %s: %s", target:GetFullName(), message)
	)
end

--[[
	Applies a line-range replacement. Lines are 1-based and inclusive, matching
	what `script_read` returns, so an agent can read lines 40-60 and write back
	to exactly those numbers without an off-by-one conversion.
]]
function ScriptEdit.replaceLines(
	target: LuaSourceContainer,
	startLine: number,
	endLine: number,
	replacement: string
)
	ScriptEdit.write(target, function(source)
		local lines = ScriptEdit.toLines(source)
		if startLine < 1 or startLine > #lines + 1 then
			Dispatch.fail(
				"BAD_RANGE",
				string.format(
					"startLine %d is outside %s, which has %d lines.",
					startLine,
					target:GetFullName(),
					#lines
				),
				"Call script_read on this script first to get current line numbers; "
					.. "they shift after every edit."
			)
		end

		local result: { string } = {}
		table.move(lines, 1, startLine - 1, 1, result)
		for _, line in ScriptEdit.toLines(replacement) do
			table.insert(result, line)
		end
		if endLine < #lines then
			table.move(lines, endLine + 1, #lines, #result + 1, result)
		end
		return table.concat(result, "\n")
	end)
end

function ScriptEdit.toLines(source: string): { string }
	local lines: { string } = {}
	for line in string.gmatch(source .. "\n", "([^\n]*)\n") do
		table.insert(lines, line)
	end
	-- gmatch on the sentinel newline yields one trailing empty entry.
	if #lines > 0 and lines[#lines] == "" then
		table.remove(lines)
	end
	return lines
end

--[[
	True for instances that hold Luau source. Used to keep script tools from
	being pointed at ordinary instances with a confusing property error.
]]
function ScriptEdit.isScript(instance: Instance): boolean
	return instance:IsA("LuaSourceContainer")
end

return ScriptEdit
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX8">
      <Properties>
        <string name="Name">Transport</string>
        <ProtectedString name="Source"><![CDATA[--!strict
--[[
	Command channel between the bridge and this Studio instance.

	Preferred path is a single Server-Sent Events stream opened with
	`HttpService:CreateWebStreamClient`, which pushes commands the moment they are
	issued. Every other Roblox Studio MCP server long-polls on a fixed interval,
	which adds half the poll period to every single call and keeps a request in
	flight forever; a stream costs nothing while idle.

	Studio allows only 4 concurrent web stream connections and closes them after
	30 minutes, so exactly one stream is held and reconnects are treated as
	routine. Where web streams are unavailable (older Studio builds, or the 4
	slots being taken by other plugins) the same command loop runs over long-poll
	instead, and neither the server nor the handlers can tell the difference.
]]

local HttpService = game:GetService("HttpService")

local Config = require(script.Parent.Config)
local Net = require(script.Parent.Net)

local Transport = {}

export type Status = "disconnected" | "connecting" | "connected"

type Callbacks = {
	onCommand: (id: string, op: string, params: { [string]: any }?) -> (),
	onStatus: (status: Status, detail: string?) -> (),
}

local running = false
local studioId: string = ""
local activeStream: any = nil
local mode: "sse" | "poll" = "sse"

--[[
	True when this Studio build exposes web streams. Guarded rather than assumed:
	the API shipped in August 2025 and users on older builds must still work.
]]
local function supportsWebStream(): boolean
	if typeof((HttpService :: any).CreateWebStreamClient) ~= "function" then
		return false
	end
	local ok, enumItem = pcall(function()
		return (Enum :: any).WebStreamClientType.SSE
	end)
	return ok and enumItem ~= nil
end

local function identity(transport: string): { [string]: any }
	return {
		studioId = studioId,
		placeName = if game.Name ~= "" then game.Name else "Untitled place",
		placeId = game.PlaceId,
		pluginVersion = Config.PLUGIN_VERSION,
		transport = transport,
	}
end

--[[
	Parses one SSE payload. `MessageReceived` hands over the event data, but the
	exact framing is not contractual, so a stray `data:` prefix is tolerated and
	comment/keepalive lines are dropped.
]]
local function parseFrame(message: string): { [string]: any }?
	local text = (string.gsub(message, "^%s+", ""))
	if text == "" or string.sub(text, 1, 1) == ":" then
		return nil
	end
	if string.sub(text, 1, 5) == "data:" then
		text = (string.gsub(string.sub(text, 6), "^%s+", ""))
	end
	local decoded = Net.decode(text)
	if typeof(decoded) ~= "table" then
		return nil
	end
	return decoded
end

local function handleFrame(callbacks: Callbacks, frame: { [string]: any })
	local id = frame.id
	local op = frame.op
	if typeof(id) == "string" and typeof(op) == "string" then
		callbacks.onCommand(id, op, frame.params)
	end
end

--[[
	Opens the stream and blocks until it closes. Returns false when the stream
	could not be opened at all, which is the signal to fall back to long-poll.
]]
local function runStream(callbacks: Callbacks): boolean
	local opened = false

	local ok, client = pcall(function()
		return (HttpService :: any):CreateWebStreamClient((Enum :: any).WebStreamClientType.SSE, {
			Url = Config.baseUrl() .. "/events",
			Method = "POST",
			Headers = Config.headers(),
			Body = HttpService:JSONEncode(identity("sse")),
		})
	end)

	if not ok or client == nil then
		return false
	end

	activeStream = client
	local connections: { RBXScriptConnection } = {}

	table.insert(
		connections,
		client.Opened:Connect(function(statusCode: number)
			if statusCode == 200 then
				opened = true
				mode = "sse"
				callbacks.onStatus("connected", "streaming")
			end
		end)
	)

	table.insert(
		connections,
		client.MessageReceived:Connect(function(message: string)
			local frame = parseFrame(message)
			if frame then
				handleFrame(callbacks, frame)
			end
		end)
	)

	local streamError: string? = nil
	table.insert(
		connections,
		client.Error:Connect(function(statusCode: number, errorMessage: string)
			streamError = string.format("stream error %d: %s", statusCode, tostring(errorMessage))
		end)
	)

	client.Closed:Wait()
	for _, connection in connections do
		connection:Disconnect()
	end
	activeStream = nil

	if not opened then
		callbacks.onStatus("disconnected", streamError or Net.explain("could not connect"))
		return false
	end
	callbacks.onStatus("disconnected", "stream closed")
	return true
end

--[[
	Long-poll fallback. The bridge parks each request for ~25s and answers with a
	command or an idle marker, so this is a blocking wait rather than a busy loop.
]]
local function runPolling(callbacks: Callbacks)
	mode = "poll"
	local handshake = Net.postJson("/connect", identity("poll"))
	if not handshake.ok then
		callbacks.onStatus("disconnected", handshake.error or "handshake failed")
		return
	end
	callbacks.onStatus("connected", "polling")

	while running do
		local response = Net.request("GET", "/poll?studioId=" .. studioId)
		if not running then
			return
		end

		if response.statusCode == 409 then
			-- The server restarted and no longer knows us; re-handshake.
			local retry = Net.postJson("/connect", identity("poll"))
			if not retry.ok then
				callbacks.onStatus("disconnected", retry.error or "reconnect failed")
				return
			end
		elseif not response.ok then
			callbacks.onStatus("disconnected", response.error or "poll failed")
			return
		else
			local payload = Net.decode(response.body)
			if typeof(payload) == "table" and typeof(payload.command) == "table" then
				handleFrame(callbacks, payload.command)
			end
		end
	end
end

--[[
	Posts a command result. Fire-and-forget: if it fails the server's own timeout
	will surface an actionable error to the agent, and retrying here would risk
	answering a request that has already been abandoned.
]]
function Transport.sendResult(result: { [string]: any })
	task.spawn(function()
		Net.postJson("/result?studioId=" .. studioId, result)
	end)
end

function Transport.getMode(): string
	return mode
end

function Transport.isRunning(): boolean
	return running
end

--[[
	Connects and keeps reconnecting until `stop` is called. Backs off on repeated
	failure so a server that is simply not running does not spin the CPU.
]]
function Transport.start(id: string, callbacks: Callbacks)
	if running then
		return
	end
	running = true
	studioId = id

	task.spawn(function()
		local delay = Config.RECONNECT_DELAY
		while running do
			callbacks.onStatus("connecting")

			local streamed = supportsWebStream() and runStream(callbacks)
			if running and not streamed then
				runPolling(callbacks)
			end

			if not running then
				break
			end
			task.wait(delay)
			delay = math.min(delay * 2, Config.MAX_RECONNECT_DELAY)
			-- A connection that lasted long enough to do real work resets the
			-- backoff; only repeated fast failures should slow retries down.
			if activeStream ~= nil then
				delay = Config.RECONNECT_DELAY
			end
		end
	end)
end

function Transport.stop()
	if not running then
		return
	end
	running = false
	pcall(function()
		Net.postJson("/bye?studioId=" .. studioId, {})
	end)
	if activeStream then
		pcall(function()
			activeStream:Close()
		end)
		activeStream = nil
	end
end

return Transport
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX9">
      <Properties>
        <string name="Name">Undo</string>
        <ProtectedString name="Source"><![CDATA[--!strict
--[[
	Wraps every mutation in a ChangeHistoryService recording.

	Two things fall out of this that competing servers do not give you:

	1. One agent action is one Ctrl+Z. A tool that creates 200 parts collapses to
	   a single undo step named after the tool, instead of 200 separate steps or
	   -- worse -- no undo entry at all.
	2. A batch that fails part way through is *cancelled*, not committed. Without
	   this, a `modify` call that sets 5 of 10 properties and then hits a bad
	   value leaves the place in a half-edited state the user has to unpick by
	   hand.

	`SetWaypoint` is deliberately not used; it has been superseded by recordings
	and cannot express the cancel case.
]]

local ChangeHistoryService = game:GetService("ChangeHistoryService")

local Undo = {}

--[[
	Runs `body` inside a named recording and returns its result.

	`TryBeginRecording` returns nil when another recording is already open (for
	example the user is mid-drag in the viewport) or when history is unavailable.
	The work still runs in that case -- refusing to act would be worse than a
	slightly coarser undo stack -- it simply joins the surrounding recording.
]]
function Undo.record<T>(name: string, displayName: string, body: () -> T): T
	local identifier = ChangeHistoryService:TryBeginRecording(name, displayName)
	if not identifier then
		return body()
	end

	local ok, result = pcall(body)
	if ok then
		ChangeHistoryService:FinishRecording(identifier, Enum.FinishRecordingOperation.Commit)
		return result
	end

	ChangeHistoryService:FinishRecording(identifier, Enum.FinishRecordingOperation.Cancel)
	error(result, 0)
end

--[[
	Commits the recording even when `body` fails, for operations whose partial
	effects are still wanted. Used only by handlers that report per-item results
	and therefore tell the agent exactly what did and did not apply.
]]
function Undo.recordPartial<T>(name: string, displayName: string, body: () -> T): T
	local identifier = ChangeHistoryService:TryBeginRecording(name, displayName)
	if not identifier then
		return body()
	end

	local ok, result = pcall(body)
	ChangeHistoryService:FinishRecording(identifier, Enum.FinishRecordingOperation.Commit)
	if not ok then
		error(result, 0)
	end
	return result
end

return Undo
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
