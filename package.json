{
  "name": "@el4cteo/rbx-studio-mcp",
  "version": "0.1.7",
  "description": "MCP server for Roblox Studio. 29 tools, push-based SSE bridge, editor-safe script edits, one-step undo.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rbx-studio-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "build:plugin": "node scripts/check-plugin.mjs && node scripts/build-plugin.mjs",
    "sourcemap": "node scripts/sourcemap.mjs",
    "test": "node scripts/test-plugin.mjs && node scripts/test-bridge.mjs",
    "build:all": "npm run build && npm run build:plugin",
    "install:plugin": "node scripts/install-plugin.mjs",
    "check:plugin": "node scripts/check-plugin.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "roblox",
    "roblox-studio",
    "luau",
    "claude",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "author": "EL4CTEO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EL4CTEO/rbx-studio-mcp.git"
  },
  "homepage": "https://github.com/EL4CTEO/rbx-studio-mcp#readme",
  "bugs": {
    "url": "https://github.com/EL4CTEO/rbx-studio-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
