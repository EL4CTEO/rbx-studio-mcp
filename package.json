{
  "name": "@el4cteo/rbx-studio-mcp",
  "version": "1.2.1",
  "description": "MCP server for Roblox Studio. 35 tools, push-based SSE bridge, two-way script sync with files, editor-safe script edits, one-step undo. Native, single binary.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rbx-studio-mcp": "bin/rbx-studio-mcp.js"
  },
  "files": [
    "bin",
    "config/dsh.cordis.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./config/dsh.cordis.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "cargo build --release --manifest-path server/Cargo.toml",
    "start": "node bin/rbx-studio-mcp.js",
    "build:plugin": "node scripts/check-plugin.mjs && node scripts/build-plugin.mjs",
    "sourcemap": "node scripts/sourcemap.mjs",
    "test": "cargo test --manifest-path server/Cargo.toml && node scripts/test-plugin.mjs && node scripts/test-transport.mjs && node scripts/test-native.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:live:v090": "node scripts/test-live-v090.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "check:plugin": "node scripts/check-plugin.mjs",
    "doctor": "node bin/rbx-studio-mcp.js doctor",
    "prepublishOnly": "node scripts/publish-platforms.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "roblox",
    "roblox-studio",
    "roblox-development",
    "luau",
    "claude",
    "claude-code",
    "cursor",
    "ai",
    "ai-agent"
  ],
  "optionalDependencies": {
    "@el4cteo/rbx-studio-mcp-win32-x64": "1.2.1",
    "@el4cteo/rbx-studio-mcp-win32-arm64": "1.2.1",
    "@el4cteo/rbx-studio-mcp-darwin-arm64": "1.2.1",
    "@el4cteo/rbx-studio-mcp-darwin-x64": "1.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "author": "EL4CTEO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EL4CTEO/rbx-studio-mcp.git"
  },
  "homepage": "https://github.com/EL4CTEO/rbx-studio-mcp#readme",
  "bugs": {
    "url": "https://github.com/EL4CTEO/rbx-studio-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
